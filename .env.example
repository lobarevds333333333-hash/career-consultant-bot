# Токен бота — получите у @BotFather при создании бота
BOT_TOKEN=1234567890:AAExxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Telegram ID менеджера, которому приходят уведомления о заявках.
# Узнать свой ID можно у @userinfobot.
# Важно: менеджер должен сначала написать боту (/start), иначе Telegram
# не разрешит боту отправлять ему сообщения первому.
# Если менеджер использует группу — добавьте бота в группу и укажите её ID (отрицательное число).
MANAGER_CHAT_ID=123456789

# Ссылка на Telegram-канал по профориентации
CHANNEL_URL=https://t.me/your_channel

# Путь к файлу базы данных SQLite (создаётся автоматически)
DB_PATH=career_bot.db
